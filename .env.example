# ============================================================
# Short Scanner — Variables de entorno (plantilla)
# ============================================================
# Copiar a .env y rellenar. NUNCA commitear el .env real.
# Deploy objetivo: Dokploy + Postgres administrado
#                  (docker/docker-compose.dokploy-managed-pg.yml)
#
# Fuente de verdad del schema: apps/api/src/config/env.validation.ts
#
# Notas:
#  - Las migraciones corren solas al arrancar (migrationsRun: true).
#  - Binance NO necesita API key (endpoints públicos de futures).
#  - El token de Telegram es per-usuario y va cifrado en BD, NO aquí.
# ============================================================


# ─── Infraestructura ─────────────────────────────────────────
NODE_ENV=production
PORT=3000
LOG_LEVEL=info
# Dominio público del frontend (servicio web), coma-separado si son varios.
CORS_ORIGINS=https://app.tudominio.com


# ─── Base de datos ───────────────────────────────────────────
# "Internal Connection" del Postgres administrado de Dokploy.
DATABASE_URL=postgresql://<user>:<pass>@<host-interno-dokploy>:5432/<db>


# ─── Redis (BullMQ + cache) ──────────────────────────────────
# Embebido en el stack → red interna del compose.
REDIS_URL=redis://redis:6379


# ─── JWT auth (propio) ───────────────────────────────────────
# Generar: openssl rand -base64 64
JWT_SECRET=replace-with-openssl-rand-base64-64
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d


# ─── Cifrado de tokens Telegram en BD ────────────────────────
# Clave AES-256-GCM (32 bytes hex). Generar: openssl rand -hex 32
# ⚠️ No rotar sin re-cifrar: los tokens TG existentes quedarán ilegibles.
TELEGRAM_ENCRYPTION_KEY=replace-with-32-byte-hex


# ─── APIs externas (base URLs públicas) ──────────────────────
BINANCE_FUTURES_BASE_URL=https://fapi.binance.com
TELEGRAM_API_BASE_URL=https://api.telegram.org
