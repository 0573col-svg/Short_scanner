# ============================================================
# Short Scanner — Backend NestJS — Variables de entorno
# ============================================================
# Copiar a .env y rellenar valores. NUNCA commitear el .env real.
#
# Reglas:
#  - Secretos y claves de cifrado: SÍ en este archivo.
#  - URLs públicas inmutables: pueden ir como base URL configurable.
#  - Credenciales per-usuario (Telegram token de cada user): NO van aquí,
#    van cifradas en la BD (tabla TelegramConfig).
#  - Binance NO necesita API key: los endpoints usados son públicos.
#  - Auth la maneja Supabase Auth; nosotros NO firmamos JWTs propios.
# ============================================================


# ─── Infraestructura ─────────────────────────────────────────
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:5173

# ─── Defaults para dev local con docker compose ─────────────
# Si corres `docker compose -f docker/docker-compose.yml up -d`:
#   DATABASE_URL=postgresql://postgres:postgres@localhost:5432/shortscanner
#   DATABASE_DIRECT_URL=postgresql://postgres:postgres@localhost:5432/shortscanner
#   REDIS_URL=redis://localhost:6379
# Y omite las vars de Supabase (se stubean en Fase 1).


# ─── Supabase ────────────────────────────────────────────────
# Dashboard → Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=replace-with-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key
SUPABASE_JWT_ISSUER=https://your-project-ref.supabase.co/auth/v1
SUPABASE_JWT_JWKS_URI=https://your-project-ref.supabase.co/auth/v1/.well-known/jwks.json
# ⚠️ SUPABASE_SERVICE_ROLE_KEY: NUNCA exponer al frontend ni commitear.


# ─── Base de datos (Supabase Postgres) ───────────────────────
# Dashboard → Settings → Database → Connection string
#
# DATABASE_URL       = Session pooler (puerto 5432, host con "pooler")
#                       → para la app NestJS (proceso persistente)
# DATABASE_DIRECT_URL = Direct connection (puerto 5432, host db.<ref>...)
#                       → para migraciones TypeORM
#
# ⚠️ NO usar el Transaction pooler (puerto 6543) con TypeORM:
#   rompe queries por falta de prepared statements.
DATABASE_URL=postgresql://postgres.<ref>:<pass>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_DIRECT_URL=postgresql://postgres:<pass>@db.<ref>.supabase.co:5432/postgres


# ─── Redis (Upstash recomendado para managed) ────────────────
REDIS_URL=rediss://default:<pass>@<host>.upstash.io:6379
# Para local dev:
# REDIS_URL=redis://localhost:6379


# ─── Cifrado de tokens Telegram en BD ────────────────────────
# Generar con: openssl rand -hex 32
# ⚠️  No rotar sin plan de re-cifrado, los tokens TG existentes
#    quedarán ilegibles.
TELEGRAM_ENCRYPTION_KEY=replace-with-32-byte-hex


# ─── APIs externas (base URLs, públicas, no son secretos) ────
# El scanner es futures-only: usa /fapi/v1/ticker/24hr, /fapi/v1/klines y
# /fapi/v1/premiumIndex. Solo se shortea con leverage en futures.
BINANCE_FUTURES_BASE_URL=https://fapi.binance.com
TELEGRAM_API_BASE_URL=https://api.telegram.org

# Para tests/dev contra testnet de futures, descomentar:
# BINANCE_FUTURES_BASE_URL=https://testnet.binancefuture.com


# ─── Scanner ─────────────────────────────────────────────────
SCAN_INTERVAL_CRON=*/2 * * * *
SCAN_LOCK_TTL_SECONDS=110
BINANCE_RATE_LIMIT_WEIGHT_BUDGET=1100
BINANCE_BATCH_SIZE=10
BINANCE_REQUEST_TIMEOUT_MS=8000


# ─── Workers / colas BullMQ ──────────────────────────────────
BULLMQ_PREFIX=shortscanner
ALERTS_QUEUE_CONCURRENCY=5


# ─── Tracking matured-verdict (Fase 6) ───────────────────────
# Window de monitoreo para que un token alcance las 4 Ever-flags
# antes de archivarse. Default = 96h = 4 días = 345600000 ms.
#
# Para QA acelerado: descomentar la línea de abajo (5 min de window).
# Permite verificar end-to-end (BD → transición → BullMQ → Telegram)
# sin esperar 4 días reales. Combinar con un SQL seed de un token
# activo prendiéndole las 4 Ever-flags + activeMs bajo:
#
#   UPDATE tracked_tokens SET "rsiEverPassed"=true, "fundingEverPassed"=true,
#     "divergenceEverPassed"=true, "redCandlesEverPassed"=true,
#     "activeMs"=60000, "maturedVerdict"=NULL, "maturedAlertedAt"=NULL
#   WHERE symbol='<UN-TOKEN-ACTIVE>';
#
# ⚠️ EN PRODUCCIÓN dejar comentado o explícito en 345600000.
# MATURED_WINDOW_MS=300000
